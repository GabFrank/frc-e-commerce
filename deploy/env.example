# Variables de entorno para frc-e-commerce en producción.
# Path final en el droplet: /opt/frc-e-commerce/shared/.env
# Permisos: 0600, owner frc:frc
#
# NO commitear este archivo con valores reales — este es solo template.

# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Base de datos (postgres local, puerto 5551) ────────────────────────────────
# Reemplazar <DB_PASSWORD> con el password generado por bootstrap-droplet.sh
DATABASE_URL=postgres://frc_ecommerce:<DB_PASSWORD>@127.0.0.1:5551/frc_ecommerce

# ── Better Auth ────────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=<GENERAR_32_CHARS_RANDOM>
BETTER_AUTH_URL=https://app.frc-ecommerce.com

# ── Tenant resolution ──────────────────────────────────────────────────────────
# Fallback de slug cuando no hay subdominio (útil para single-tenant initial).
# Borrar esta línea cuando se habilite multi-tenancy por subdominio.
DEV_TENANT_SLUG=

# ── Cloudflare R2 (Storage) ────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=frc-e-commerce-assets
R2_PUBLIC_BASE_URL=https://assets.frc-ecommerce.com

# ── Email transaccional (Resend) — Fase 2 ──────────────────────────────────────
# RESEND_API_KEY=

# ── Pagos online (Stripe) — Fase 2 ─────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# ── Observabilidad — opcional ──────────────────────────────────────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# ── Seed (solo se usan al correr scripts/seed.ts manualmente) ──────────────────
# SEED_SUPER_EMAIL=admin@frc-ecommerce.com
# SEED_SUPER_PASSWORD=<password-fuerte>
# SEED_TENANT_SLUG=frc
# SEED_TENANT_NAME=FRC
# SEED_TENANT_SLOGAN=
# SEED_RECEIPT_HEADER=
# SEED_RECEIPT_FOOTER=
