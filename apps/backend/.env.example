# Server
APP_ENV=dev
PORT=3000

# Storefront
STOREFRONT_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001

# Auth
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin
COOKIE_SECRET=change-me-in-production

# Database
# Si DATABASE_URL está vacío, usa SQLite en ./vendure.sqlite (dev)
# DATABASE_URL=postgres://user:pass@localhost:5432/frc_ecommerce_dev
# DATABASE_SSL=false

# Cloudflare R2 (storage)
# Si R2_BUCKET y R2_ACCOUNT_ID están vacíos, usa disco local en ./static/assets
# R2_ACCOUNT_ID=
# R2_BUCKET=frc-e-commerce-assets
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# ASSET_URL_PREFIX=https://assets.frc-e-commerce.com/

# Email
EMAIL_FROM="frc-e-commerce <noreply@frc-e-commerce.com>"

# SIFEN (fase futura)
# FRC_EFACT_API_URL=
# FRC_EFACT_API_KEY=
